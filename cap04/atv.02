<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tabela Semântica Cap. 4 Ativ. 2</title>
</head>
<body>
  <h1>Tabela Semântica com Mesclagem</h1>

  <table border="1">
    <caption>Notas Bimestrais — Turma Sistemas de Informação, 2026</caption>
    <thead>
      <tr>
        <th rowspan="2" scope="col">Aluno</th>
        <th colspan="4" scope="colgroup">Bimestres</th>
        <th rowspan="2" scope="col">Média Final</th>
      </tr>
      <tr>
        <th scope="col">1º Bimestre</th>
        <th scope="col">2º Bimestre</th>
        <th scope="col">3º Bimestre</th>
        <th scope="col">4º Bimestre</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <th scope="row">Ana Silva</th>
        <td>8.5</td>
        <td>9.0</td>
        <td>8.0</td>
        <td>9.5</td>
        <td>8.8</td>
      </tr>
      <tr>
        <th scope="row">Bruno Souza</th>
        <td>7.0</td>
        <td>6.5</td>
        <td>8.0</td>
        <td>7.5</td>
        <td>7.3</td>
      </tr>
      <tr>
        <th scope="row">Carla Dias</th>
        <td>9.5</td>
        <td>10.0</td>
        <td>9.0</td>
        <td>9.5</td>
        <td>9.5</td>
      </tr>
      <tr>
        <th scope="row">Daniel Lima</th>
        <td>6.0</td>
        <td>5.5</td>
        <td>7.0</td>
        <td>6.5</td>
        <td>6.3</td>
      </tr>
      <tr>
        <th scope="row">Eduardo Ramos</th>
        <td>8.0</td>
        <td>8.5</td>
        <td>8.5</td>
        <td>9.0</td>
        <td>8.5</td>
      </tr>
      <tr>
        <th scope="row">Fernanda Alves</th>
        <td>10.0</td>
        <td>9.5</td>
        <td>9.0</td>
        <td>10.0</td>
        <td>9.6</td>
      </tr>
    </tbody>
    <tfoot>
      <tr>
        <th scope="row" colspan="1">Média da turma</th>
        <td>8.2</td>
        <td>8.2</td>
        <td>8.25</td>
        <td>8.67</td>
        <td>8.33</td>
      </tr>
    </tfoot>
  </table>

  <p><a href="../index.html">Voltar à página principal</a></p>
</body>
</html>
